{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://rincon-riichi-api.onrender.com/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rincon-riichi-api.onrender.com/:path*"
    }
  ]
}
